# --- LLM: DeepSeek (OpenAI-compatible) ---
# Kamu bilang cuma punya ini, jadi default ke DeepSeek.
DEEPSEEK_API_KEY=sk-isi-key-kamu
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Isi sesuai nama di dashboard kamu. Contoh: deepseek-chat
# Kalau panel kamu nyebutnya "v4 flash", isi persis string itu di sini.
DEEPSEEK_MODEL=deepseek-chat

# --- Embeddings: lokal CPU (hemat, tidak perlu API) ---
# Multilingual ID+EN, ringan untuk portofolio
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vector DB: pgvector ---
DATABASE_URL=postgresql+psycopg://portoai:portoai@localhost:5433/portoai
PG_COLLECTION=porto_docs

# --- OCR / Chunk ---
OCR_DPI=300
OCR_WORKERS=4
PDF_TEXT_MIN_CHARS=100  # halaman PDF dengan teks >= ini langsung dipakai, tanpa OCR
EMBED_BATCH_SIZE=32
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# --- Hybrid retrieval (Fase 1 v2) ---
HYBRID_VECTOR_K=20
HYBRID_KEYWORD_K=20

# --- Reranker (Fase 2 v2, CPU) ---
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20
RERANK_BATCH_SIZE=16

# --- Agent (Fase 3 v2, LangGraph) ---
AGENT_ENABLED=true
AGENT_MAX_REWRITE=1
